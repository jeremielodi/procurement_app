# Database

DB_HOST=localhost
DB_NAME=wwf_procurement
DB_USER=camunda
DB_PASSWORD=camunda
DB_PORT=5432

# Camunda
CAMUNDA_REST_URL=http://localhost:8080/engine-rest
CAMUNDA_USERNAME='superuser@goflow.com'
CAMUNDA_PASSWORD='superUser123'

# Server
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
FRONTEND_URL=http://localhost:3000

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@procurement.com
# Super administrateur de la plateforme procureApp (créé au premier démarrage)
SUPERADMIN_EMAIL=superadmin@procureapp.com
SUPERADMIN_PASSWORD=change-me-now
# Fuseau horaire des dates affichées dans les emails / PDF
APP_TIMEZONE=Africa/Kinshasa

# Stockage des fichiers uploadés : minio (docker compose) ou local (UPLOAD_DIR)
STORAGE_DRIVER=local
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# Identifiants du serveur MinIO (lus aussi par le service minio de docker compose)
MINIO_ROOT_USER=procureapp
MINIO_ROOT_PASSWORD=change-me-long-random-secret
MINIO_BUCKET=procureapp
# Optionnel : identifiants dédiés à l'application (sinon MINIO_ROOT_*)
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=

# Adresse publique de l'application (liens des emails). En https:// les en-têtes HTTPS stricts
# (upgrade-insecure-requests, HSTS…) sont activés ; en http:// ils sont désactivés.
APP_URL=http://localhost:5000
