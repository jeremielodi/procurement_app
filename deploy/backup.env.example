# Copier en deploy/backup.env (lu par deploy/backup.sh) puis adapter. Aucun secret ici.
BACKUP_DIR=/var/backups/procureapp
BACKUP_RETENTION_DAYS=14
# Copie hors serveur (facultative) : rsync (user@hote:/chemin) ou rclone (nom-du-remote:chemin)
#BACKUP_REMOTE=backup@nas.example.org:/srv/backups/procureapp
#BACKUP_REMOTE=s3-sauvegardes:procureapp
