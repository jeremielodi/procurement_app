      <bpmndi:BPMNEdge id="Flow_LotStart_CreatePO_di" bpmnElement="Flow_LotStart_CreatePO">
        <di:waypoint x="2428" y="802" />
        <di:waypoint x="2460" y="802" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CreatePO_POApproval_di" bpmnElement="Flow_CreatePO_POApproval">
        <di:waypoint x="2540" y="762" />
